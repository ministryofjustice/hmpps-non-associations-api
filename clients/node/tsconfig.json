 {
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/node26/tsconfig.json",
  "compileOnSave": true,
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "strict": true,
    "isolatedModules": true,
    "types": [
      "node",
      "jest",
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
  ],
  "include": ["src/**/*.ts"],
}
